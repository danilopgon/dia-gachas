{
  "name": "dia-gachas",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c green,blue \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter dia-gachas-api start:dev",
    "dev:web": "pnpm --filter dia-gachas-web start",
    "build:api": "pnpm --filter dia-gachas-api build",
    "build:web": "pnpm --filter dia-gachas-web build",
    "build": "pnpm build:api && pnpm build:web",
    "start:api": "pnpm --filter dia-gachas-api start:prod",
    "clean": "rimraf backend/dist frontend/dist",
    "lint:api": "pnpm --filter dia-gachas-api lint",
    "lint:web": "pnpm --filter dia-gachas-web lint",
    "lint": "pnpm lint:api && pnpm lint:web",
    "lint:fix": "pnpm --filter dia-gachas-api lint:fix && pnpm --filter dia-gachas-web lint:fix",
    "test:api": "pnpm --filter dia-gachas-api test",
    "test:web": "pnpm --filter dia-gachas-web test",
    "municipios:generar": "node scripts/municipios/generar.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@10.34.8"
}
